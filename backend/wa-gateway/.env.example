# Postgres — the SAME database Kadai uses (durable Baileys session state lives
# in wa_auth_creds / wa_signal_keys). Either a full URL or discrete DB_* parts.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kadai
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=kadai
# DB_USER=postgres
# DB_PASSWORD=postgres
# Managed Postgres (Render/Cloud SQL) needs SSL.
DATABASE_SSL=false

# Shared secret on every call in both directions (Kadai <-> gateway).
# Must match the Kadai backend's WA_GATEWAY_SECRET.
WA_GATEWAY_SECRET=change-me

# Where the gateway posts inbound messages + link status (the Kadai API base).
WA_KADAI_CALLBACK_URL=http://127.0.0.1:8080

# Turn a bare 10-digit local number into a WhatsApp JID. Mirrors Kadai's setting.
WA_DEFAULT_COUNTRY_CODE=91

# HTTP port. Cloud Run sets this (8080); locally defaults to 8788.
PORT=8788

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
