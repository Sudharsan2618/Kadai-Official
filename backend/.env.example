APP_ENV=local                      # local | staging | production
PORT=8010                          # Cloud Run injects this
LOG_LEVEL=INFO
JSON_LOGS=false                    # true on Cloud Run (structured logging)
CORS_ORIGINS=http://localhost:3010,http://localhost:3000
FRONTEND_URL=http://localhost:3010
RUN_MIGRATIONS=true
SEED_DEMO_DATA=false               # true only for a demo/dev database
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=                       # [secret]
DB_SCHEMA=kadai
DB_SSLMODE=require
JWT_SECRET=kadai-dev-secret-change-me    # [secret]
JWT_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=              # [secret]
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback
WA_MODE=baileys                    # mock | baileys
# Baileys gateway sidecar (the Node service that owns the WhatsApp socket).
WA_GATEWAY_URL=http://127.0.0.1:8788
WA_GATEWAY_SECRET=change-me        # [secret] shared with the gateway, both directions
WA_GATEWAY_TIMEOUT=20
WA_DEFAULT_COUNTRY_CODE=91
BROADCAST_MSGS_PER_SEC=4
MOCK_FAIL_RATE=0.04
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=               # [secret]
RAZORPAY_WEBHOOK_SECRET=           # [secret]
PLAN_ID=kadai_monthly
PLAN_NAME=Kadai Monthly
PLAN_PRICE_INR=1500
PLAN_PERIOD_DAYS=30
TRIAL_DAYS=14