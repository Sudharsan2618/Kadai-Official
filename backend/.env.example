APP_ENV=local                      # local | staging | production
PORT=8010                          # Cloud Run injects this
LOG_LEVEL=INFO
JSON_LOGS=false                    # true on Cloud Run (structured logging)
CORS_ORIGINS=http://localhost:3010,http://localhost:3000
FRONTEND_URL=http://localhost:3010
RUN_MIGRATIONS=true
SEED_DEMO_DATA=false               # true only for a demo/dev database
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=                       # [secret]
DB_SCHEMA=kadai
DB_SSLMODE=require
JWT_SECRET=kadai-dev-secret-change-me    # [secret]
JWT_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=              # [secret]
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback
WA_MODE=mock                       # mock | cloud
META_APP_ID=
META_APP_SECRET=                   # [secret] webhook signature + token exchange
META_ES_CONFIG_ID=                 # Embedded Signup configuration id
WA_VERIFY_TOKEN=                   # [secret] GET /wa/webhook handshake
WA_TOKEN_ENC_KEY=                  # [secret] Fernet key for per-shop tokens at rest
WA_API_VERSION=v25.0
WA_GRAPH_TIMEOUT=20
WA_DEFAULT_COUNTRY_CODE=91
WA_MM_MESSAGE_ACTIVITY_SHARING=true
BROADCAST_MSGS_PER_SEC=10
MOCK_FAIL_RATE=0.04
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=               # [secret]
RAZORPAY_WEBHOOK_SECRET=           # [secret]
PLAN_ID=kadai_monthly
PLAN_NAME=Kadai Monthly
PLAN_PRICE_INR=1500
PLAN_PERIOD_DAYS=30
TRIAL_DAYS=14