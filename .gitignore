# ─────────────────────────────────────────────
# Root .gitignore (monorepo: backend=Python/FastAPI, frontend=Next.js)
# Per-package .gitignore files (backend/, frontend/) also apply.
# ─────────────────────────────────────────────

# ── Secrets & env ──
.env
.env.*
!.env.example
*.pem

# ── Python (backend) ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
*.sqlite3
kadai.db

# ── Node / Next.js (frontend) ──
node_modules/
.pnp
.pnp.*
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Editors / IDEs ──
.vscode/
.idea/
*.swp
*.swo

# ── Research cache ──
.firecrawl/
